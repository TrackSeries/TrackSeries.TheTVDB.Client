<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <AssemblyName>TrackSeries.TheTVDB.Client</AssemblyName>
    <AssemblyTitle>TrackSeries.TheTVDB.Client</AssemblyTitle>
    <PackageId>TrackSeries.TheTVDB.Client</PackageId>
    <Description>.NET Client for TheTVDB API integrated with IHttpClientFactory and IServiceCollection</Description>
    <PackageTags>TheTVDB;Client</PackageTags>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

  <!-- .NET Standard 2.0 with .NET 8 extension packages for modern support -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Version="2.3.4" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
  </ItemGroup>

  <!-- .NET 8 uses framework packages where possible -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.20" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Version="8.0.20" />
    <!-- System.Text.Json, Configuration.Binder, and System.Net.Http.Json are built into .NET 8 -->
  </ItemGroup>

  <!-- .NET 9 uses latest framework packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.9" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Version="9.0.9" />
    <!-- System.Text.Json, Configuration.Binder, and System.Net.Http.Json are built into .NET 9 -->
  </ItemGroup>

</Project>
